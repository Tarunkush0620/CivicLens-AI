# Server Environment Variables
PORT=8080
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
AI_ENABLED=true
AI_MAX_CONCURRENCY=5

# Supabase (Optional - CivicLens includes an automatic high-speed local repository fallback for immediate offline/local evaluation)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Admin Access
ADMIN_PASSCODE=civiclens2026

# Duplicate Detection Configuration
DUP_RADIUS_M=100
DUP_SCORE_THRESHOLD=0.65
RATE_LIMIT_ANALYZE_PER_MIN=15
LOG_LEVEL=info

# Client Environment (set in client/.env)
# VITE_API_URL=http://localhost:8080/api
# VITE_MAPBOX_TOKEN=
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
